# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose "openai" or "ollama"
LLM_PROVIDER=ollama

# OpenAI (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (required only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_DIR=/app/data
FAISS_INDEX_PATH=/app/faiss_index
HF_HOME=/hf_cache

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=3
